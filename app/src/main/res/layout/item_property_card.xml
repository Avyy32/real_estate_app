<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="130dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/propertyImagePager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F5F5F5" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@android:color/transparent"
                app:tabBackground="@drawable/dot_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="10dp"
                app:tabRippleColor="@null" />

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Featured"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|top"
                android:layout_margin="6dp"
                android:src="@android:drawable/btn_star_big_off"
                app:tint="@color/white" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvPropertyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APARTMENT"
                android:textColor="#666666"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvPropertySubTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="3 BHK House in Sector 101, Noida"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:id="@+id/priceLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:id="@+id/tvPropertyPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 1.1 Cr"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/vertDivider"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:background="#DDDDDD"
                    app:layout_constraintBottom_toBottomOf="@id/priceLayout"
                    app:layout_constraintStart_toEndOf="@id/priceLayout"
                    app:layout_constraintTop_toTopOf="@id/priceLayout" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toEndOf="@id/vertDivider"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:id="@+id/tvPropertyArea"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2,690 sqft"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvListingType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#F0F0F0"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="Resale"
                    android:textColor="#666666"
                    android:textSize="8sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvReadyToMove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ready To Move"
                android:textColor="#666666"
                android:textSize="10sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="6dp"
                android:background="#EEEEEE" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/ivDealerAvatar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/circle_placeholder"
                    android:padding="1dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/dealerInfoLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/actionsLayout"
                    app:layout_constraintStart_toEndOf="@id/ivDealerAvatar"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:id="@+id/tvDealerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="GOYAL ASSO..."
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <Button
                        android:id="@+id/btnViewNumber"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="6dp"
                        android:text="View"
                        android:textAllCaps="false"
                        android:textSize="9sp"
                        app:cornerRadius="4dp" />

                    <ImageButton
                        android:id="@+id/btnWhatsapp"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/circle_placeholder"
                        android:backgroundTint="#25D366"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="@color/white" />

                    <ImageButton
                        android:id="@+id/btnCall"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/circle_placeholder"
                        android:backgroundTint="#007AFF"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_call"
                        app:tint="@color/white" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
