<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:text="Need Help? Post via WhatsApp"
            android:textColor="#1976D2"
            android:textSize="12sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property Details"
                android:textColor="#001F3F"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="STEP 2 OF 3"
                android:textColor="#999999"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Location Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Location / Address"
                android:textColor="#001F3F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_bg"
                android:hint="Enter Area / Society / City"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black" />

            <!-- Floors Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Total no of floors and your floor details"
                android:textColor="#001F3F"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etTotalFloors"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_bg"
                android:hint="Total Floors"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/etPropertyOnFloor"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_bg"
                android:hint="Property on floor"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Availability Status"
                android:textColor="#001F3F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReady"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready to move"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    android:textColor="@color/chip_text_selector" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUnderConst"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Under construction"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    android:textColor="@color/chip_text_selector" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Sell Specific Section -->
            <LinearLayout
                android:id="@+id/layoutSellDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Ownership"
                    android:textColor="#001F3F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgOwnership"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:singleSelection="true">
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Freehold"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        android:textColor="@color/chip_text_selector" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Leasehold"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        android:textColor="@color/chip_text_selector" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Co-operative society"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        android:textColor="@color/chip_text_selector" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Power of Attorney"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        android:textColor="@color/chip_text_selector" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <!-- Price Details Section -->
            <TextView
                android:id="@+id/tvPriceHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Price Details"
                android:textColor="#001F3F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etExpectedPrice"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_bg"
                android:hint="₹ Expected Price"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black" />

            <CheckBox
                android:id="@+id/cbAllInclusive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="All inclusive price"
                android:textColor="#666666" />
            <CheckBox
                android:id="@+id/cbNegotiable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price Negotiable"
                android:textColor="#666666" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnNextStep"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:backgroundTint="#007BFF"
        android:text="Post and Continue"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="4dp" />

</LinearLayout>
